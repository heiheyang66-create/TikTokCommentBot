<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>type</key>
			<string>PSTextGroupCell</string>
			<key>title</key>
			<string>TikTok评论回复机器人</string>
			<key>footerText</key>
			<string>自动扫描评论区，识别意向客户并自动回复</string>
		</dict>
		<dict>
			<key>type</key>
			<string>PSSwitchCell</string>
			<key>title</key>
			<string>启用机器人</string>
			<key>key</key>
			<string>isRunning</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>type</key>
			<string>PSSwitchCell</string>
			<key>title</key>
			<string>启用自动回复</string>
			<key>key</key>
			<string>replyEnabled</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>type</key>
			<string>PSGroupCell</string>
			<key>title</key>
			<string>扫描设置</string>
		</dict>
		<dict>
			<key>type</key>
			<string>PSStaticTextCell</string>
			<key>title</key>
			<string>每条视频扫描评论数</string>
			<key>key</key>
			<string>scanCommentCount</string>
			<key>default</key>
			<integer>100</integer>
		</dict>
		<dict>
			<key>type</key>
			<string>PSSwitchCell</string>
			<key>title</key>
			<string>仅强信号触发</string>
			<key>key</key>
			<string>strongSignalOnly</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>type</key>
			<string>PSGroupCell</string>
			<key>title</key>
			<string>风控模拟</string>
		</dict>
		<dict>
			<key>type</key>
			<string>PSSwitchCell</string>
			<key>title</key>
			<string>启用风控检测</string>
			<key>key</key>
			<string>riskDetectionEnabled</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>type</key>
			<string>PSStaticTextCell</string>
			<key>title</key>
			<string>回复最小间隔(秒)</string>
			<key>key</key>
			<string>replyDelayMin</string>
			<key>default</key>
			<integer>15</integer>
		</dict>
		<dict>
			<key>type</key>
			<string>PSStaticTextCell</string>
			<key>title</key>
			<string>回复最大间隔(秒)</string>
			<key>key</key>
			<string>replyDelayMax</string>
			<key>default</key>
			<integer>45</integer>
		</dict>
		<dict>
			<key>type</key>
			<string>PSGroupCell</string>
			<key>title</key>
			<string>工作循环</string>
		</dict>
		<dict>
			<key>type</key>
			<string>PSStaticTextCell</string>
			<key>title</key>
			<string>连续工作(分钟)</string>
			<key>key</key>
			<string>workDuration</string>
			<key>default</key>
			<integer>10</integer>
		</dict>
		<dict>
			<key>type</key>
			<string>PSStaticTextCell</string>
			<key>title</key>
			<string>强制休息(分钟)</string>
			<key>key</key>
			<string>restDuration</string>
			<key>default</key>
			<integer>5</integer>
		</dict>
		<dict>
			<key>type</key>
			<string>PSStaticTextCell</string>
			<key>title</key>
			<string>每日最大回复数</string>
			<key>key</key>
			<string>dailyMaxReplies</string>
			<key>default</key>
			<integer>800</integer>
		</dict>
	</array>
</dict>
</plist>
